OPENROUTER_API_KEY=
TINKER_API_KEY=
GEMINI_API_KEY=
FASTINO_API_KEY=
PIONEER_API_KEY=
SOFFICE=
# W&B: tracing (Weave) + Serverless Inference. WANDB_API_KEY enables both.
WANDB_API_KEY=
WEAVE_PROJECT=tieout
WANDB_INFERENCE_PROJECT=
# Neo4j Aura — cell-lineage knowledge graph + lexical GraphRAG (optional).
# Leave unset to no-op. Aura console gives the URI (neo4j+s://...) + password.
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# TIEOUT_GRAPH toggles the lineage write (on when creds present); TIEOUT_GRAPHRAG
# toggles the prompt-injection read (default off so it never perturbs evals).
TIEOUT_GRAPH=1
TIEOUT_GRAPHRAG=0

# --- Seapoint (close_keeper) -------------------------------------------------
# Seapoint is a REMOTE MCP server (streamable HTTP + OAuth), not a token REST API.
# In Claude Code you connect once and sign in — nothing goes in .env for that:
#   claude mcp add --transport http seapoint-staging https://mcp.seapoint.dev/mcp
#   then run /mcp and authenticate. Claude manages those OAuth tokens itself.
#
# The vars below only matter for the STANDALONE close_keeper agent (python -m
# close_keeper). All optional; leave blank to run on the local close package.
# URL selects staging/prod/local (default is the prod server):
SEAPOINT_MCP_URL=
# Set SEAPOINT_MCP_ENABLED=0 to force-disable the live connection.
SEAPOINT_MCP_ENABLED=
# Auth (first match wins):
#   1. a static bearer token, if your workspace issues one...
SEAPOINT_MCP_TOKEN=
#   2. ...or OAuth client_credentials for machine-to-machine...
SEAPOINT_MCP_CLIENT_ID=
SEAPOINT_MCP_CLIENT_SECRET=
SEAPOINT_MCP_SCOPES=
#   3. ...or interactive OAuth: dynamic client registration + PKCE, browser
#      sign-in once, token cached + refreshed. Works only where the server
#      ENABLES DCR. NOTE: the hackathon sandbox disables DCR and issues no
#      client_id, so a standalone app cannot self-authenticate there — connect
#      via the Claude connector instead (see close_keeper/README.md).
SEAPOINT_MCP_OAUTH=
# Optional: loopback callback port and token-cache path for interactive OAuth.
SEAPOINT_MCP_OAUTH_PORT=
SEAPOINT_MCP_OAUTH_CACHE=


# --- H-MEM governed-memory recall engine (Meterless) ---------------------
# Sidecar: cd harness/hmem && npm install && npx tsx src/server.ts
# The agent attaches the engine when EITHER of these is set AND the sidecar
# answers /healthz; otherwise memory runs on the governed SQLite store alone
# and the system prompt says so.
HMEM_SIDECAR_URL=http://127.0.0.1:8737
# Set CLOSE_KEEPER_HMEM=1 to enable with the default URL.
CLOSE_KEEPER_HMEM=

# --- Zetaris federated read path -----------------------------------------
# Instance runs on the vultr host (docker compose bundle, UI on :3300); this
# client talks to its UI-proxy REST API (/api/proxy/... on the UI origin).
# SSH tunnel first, Mac port 3000 to the instance's 3300:
#   ssh -fN -L 3000:localhost:3300 snapflip-vultr
# ZETARIS_API_KEY is created in the Zetaris GUI; without it the agent says
# "Zetaris is not connected" and answers from the local close package.
ZETARIS_REST_URL=http://127.0.0.1:3000
ZETARIS_API_KEY=
ZETARIS_ORG_ID=1
